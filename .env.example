# help-my-run — environment configuration.
# Copy to .env and fill in. .env is git-ignored.
#
# M5: THERE ARE NO SECRETS HERE ANYMORE. The owner password, API token, and
# Garmin credentials are all set in the web UI (first-run wizard / Settings).
# Removed in M5: API_TOKEN, GARMIN_EMAIL, GARMIN_PASSWORD.

# --- Backend storage / server ---
# Relative paths are fine with `make run-backend` (resolved against the repo
# root). If you run the bin/helpmyrun binary directly or via systemd, either
# use absolute paths or set the service's WorkingDirectory to the repo root.
DB_PATH=helpmyrun.db
PORT=8080

# --- Garmin Connect ---
# Directory where the worker persists OAuth tokens after the in-app login.
GARMIN_TOKENSTORE=~/.garminconnect

# --- Worker invocation (relative-to-repo-root is fine via make run-backend) ---
PYTHON_BIN=garmin-worker/.venv/bin/python
WORKER_SCRIPT=garmin-worker/worker.py

# --- Claude / Anthropic ---
# ⚠️ LEAVE THIS UNSET for the subscription path (the default, $0-per-token).
# `claude` prefers an env API key over your logged-in subscription, so ANY value here
# — even a placeholder — makes `claude -p` use metered API-key billing and fail with a
# 401 ("Invalid API key"). Only uncomment + set a REAL key if you deliberately want
# metered API billing instead of your Claude subscription.
# ANTHROPIC_API_KEY=

# --- Claude Code headless ---
# Path to the `claude` CLI. Log in once on this host: `claude auth login` (NOT
# --console). Headless host with no browser? Run `claude setup-token` on any
# machine and paste the token in Settings → Claude instead.
CLAUDE_BIN=claude
# Model used for vision + planning + chat.
CLAUDE_MODEL=claude-opus-4-8
# Directory where uploaded CrossFit schedule images are saved (read by `claude -p`).
IMAGE_DIR=data/crossfit

# --- M6.6: manual mode (optional) ---
# true = no automatic Garmin sync and no automatic morning verdict. Pull data
# with "Sync now" and get a verdict with "Run coach now". Nightly backups still
# run. Default false = the daily agent syncs + coaches each morning.
MANUAL_SYNC=false
