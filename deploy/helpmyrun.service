[Unit]
Description=help-my-run — self-hosted AI running coach
# Best-effort: keep trying if the network isn't up yet (Restart=always covers it).
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set to the repo/install dir by `make install`, so relative paths in .env
# (DB_PATH, GARMIN_TOKENSTORE, worker) resolve here.
WorkingDirectory=__WORKINGDIR__
# The repo .env. Leading dash = optional: a missing file is not an error.
EnvironmentFile=-__WORKINGDIR__/.env
ExecStart=%h/.local/bin/helpmyrun
Restart=always
RestartSec=5
# stdout/stderr go to journald by default (journalctl --user -u helpmyrun).

[Install]
WantedBy=default.target
